# ---------------------------------------------------------------------------
# Single source of truth for container image versions + local credentials.
# Confirmed against Maven Central + Docker Hub on 2026-06-19 (see NOTES.md).
# Gradle/Java dependency versions live in processor/versions.gradle.
# ---------------------------------------------------------------------------

# Image pins
KAFKA_IMAGE=apache/kafka:3.9.2
MINIO_IMAGE=minio/minio:RELEASE.2025-09-07T16-13-09Z
MC_IMAGE=minio/mc:RELEASE.2025-08-13T08-35-41Z
ICEBERG_REST_IMAGE=apache/iceberg-rest-fixture:1.10.1
FLINK_IMAGE=flink:1.20.4-java17
TRINO_IMAGE=trinodb/trino:481
PROMETHEUS_IMAGE=prom/prometheus:v3.1.0
GRAFANA_IMAGE=grafana/grafana:11.4.0
# Build toolchain (Flink fat jar is built in this container; no host Gradle needed)
GRADLE_IMAGE=gradle:8.10-jdk17

# Local-only credentials (synthetic; NOT real secrets). TODO: confirm with mentors
# that real deployments source these from Vault, never from a committed file.
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=password
AWS_REGION=us-east-1

# Object store / warehouse
WAREHOUSE_BUCKET=warehouse

# Kafka KRaft cluster id (fixed so storage format is reproducible)
KAFKA_CLUSTER_ID=5L6g3nShT-eMCtK--X86sw
